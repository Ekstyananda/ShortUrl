APP_NAME="Krayna Short URL"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://s.krayna.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Host "db" adalah service MySQL di docker-compose (jaringan internal, tanpa port publik).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shorturl
DB_USERNAME=shorturl
DB_PASSWORD=ganti-dengan-password-acak
# Hanya dipakai container MySQL saat inisialisasi pertama.
DB_ROOT_PASSWORD=ganti-dengan-password-root-acak

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log

# Panjang alias acak & batas redirect per menit per IP.
SHORTLINK_RANDOM_ALIAS_LENGTH=6
SHORTLINK_REDIRECT_RATE_LIMIT=120

# Jalankan migration otomatis saat container app start.
RUN_MIGRATIONS=true
